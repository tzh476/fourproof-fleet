# Cloud Run source deployment allowlist. Keep the upload equal to the Docker build context.
**
!.gcloudignore
!.dockerignore
!Dockerfile
!package.json
!package-lock.json
!index.html
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.config.ts
!src/
!src/**
!public/
!public/**
!docs/
!docs/architecture.svg
!backend/
!backend/requirements.txt
!backend/app/
!backend/app/**
backend/app/__pycache__/
backend/app/**/*.pyc
src/**/*.test.ts
src/lib/test-fixtures.ts
